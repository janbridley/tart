; tart policy extensions granted under every seatbelt.

; Allow reads to libperl.dylib for so perl runs in the seatbelt.
(allow file-read* file-test-existence file-map-executable (subpath "/System/Library/Perl"))

; Allow uv-managed CPython installs to run in the seatbelt, so venv shims like
; .venv/bin/python (symlinks into ~/.local/share/uv/python/...) can execute and
; load their stdlib.
(allow file-read* file-test-existence file-map-executable
  (regex #"^/Users/[^/]+/\.local/share/uv/"))

; Allow reading the cargo home (~/.cargo): the rustup shims in bin/, the user
; config at the top level, and the cached registry and git checkouts it builds
; from. The (/|$) anchor also matches the directory itself, so it can be listed.
(allow file-read* file-test-existence file-map-executable
  (regex #"^/Users/[^/]+/\.cargo(/|$)"))
; Registry tokens in the credentials file stay unreadable, matching the module
; rule that caller secrets must not be printable into captured output.
(deny file-read* (regex #"^/Users/[^/]+/\.cargo/\.?credentials(\.toml)?$"))
; Allow the ~/.rustup toolchains the cargo shim execs into.
(allow file-read* file-test-existence file-map-executable
  (regex #"^/Users/[^/]+/\.rustup/"))
