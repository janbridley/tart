; Secret denies, appended last in every compiled profile. The regexes match
; case-insensitively ((?i): macOS volumes usually fold case, so a secret
; stored as .ENV must not slip a lowercase-only deny) and end in (/|$) so a
; directory named like a secret denies its contents too.
; ssh: the directory, .sshrc, and OpenSSH's default key names.
(deny file-read* file-write* file-test-existence (regex #"(?i)(^|/)\.ssh(rc)?(/|$)"))
(deny file-read* file-write* file-test-existence
  (regex #"(?i)(^|/)(id_rsa|id_dsa|id_ecdsa|id_ed25519|id_xmss)([-._][^/]*)?(/|$)"))
; Environment files, dot-led (.env.local) or suffixed (prod.env), and direnv.
(deny file-read* file-write* file-test-existence (regex #"(?i)(^|/)[^/]*\.env(rc)?(\.[^/]*)?(/|$)"))

; Key/cert/keystore extensions, minus /etc, /private/etc, and /opt/homebrew
(deny file-read* file-write* file-test-existence
  (require-all
    (regex #"(?i)(\.(pem|key|p12|pfx|ppk|jks|keystore|kdbx|ovpn)(/|$))")
    (require-not (subpath "/etc"))
    (require-not (subpath "/private/etc"))
    (require-not (subpath "/opt/homebrew"))))

; Credential directories (~/.docker/config.json, ~/.kube/config, ~/.npmrc, ...
(deny file-read* file-write* file-test-existence
  (regex #"(?i)(^|/)(\.aws|\.azure|\.gnupg|\.docker|\.kube|\.netrc|\.npmrc|\.pypirc|\.git-credentials|\.config/gcloud)(/|$)"))

; Secrets under generic names: AWS-style credentials, gcloud's
; application_default[_credentials].json (kept as a bare filename because
; GOOGLE_APPLICATION_CREDENTIALS can point it anywhere), the secrets.* family.
(deny file-read* file-write* file-test-existence
  (regex #"(?i)(^|/)(credentials(\.(json|toml))?|application_default(_credentials)?\.json|secrets\.(ya?ml|json|toml))(/|$)"))
; Registry tokens: the one ~/.cargo file that must never become readable,
; wherever CARGO_HOME-style layouts put it.
(deny file-read* file-write* file-test-existence
  (regex #"(?i)(^|/)\.cargo/\.?credentials(\.toml)?(/|$)"))
